{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/USERNAME/REPOSITORY/main/catalog.json",
  "title": "Denzy A2UI Catalog",
  "description": "A2UI v0.9 catalog with a compact clickable webpage preview component.",
  "catalogId": "https://raw.githubusercontent.com/USERNAME/REPOSITORY/main/catalog.json",

  "$defs": {
    "WebPagePreview": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "WebPagePreview"
            },
            "url": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The webpage URL opened when the preview is activated."
            },
            "title": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The webpage title."
            },
            "description": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "A short webpage description."
            },
            "image": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "URL of the small webpage thumbnail."
            },
            "domain": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "The webpage domain displayed below the title."
            }
          },
          "required": [
            "component",
            "url",
            "title"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },

  "components": {
    "WebPagePreview": {
      "$ref": "#/$defs/WebPagePreview"
    }
  },

  "functions": [
    {
      "name": "openUrl",
      "description": "Opens a webpage URL.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "returnType": {
        "const": "void"
      }
    }
  ]
}