{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denzdelz-0/Taktau/refs/heads/main/anu.json",
  "title": "Denzy A2UI Catalog",
  "description": "Custom A2UI v0.9 catalog.",
  "catalogId": "https://raw.githubusercontent.com/Denzdelz-0/Taktau/refs/heads/main/anu.json",

  "components": {
    "WebPagePreview": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique component identifier."
        },
        "component": {
          "const": "WebPagePreview"
        },
        "url": {
          "type": "string",
          "description": "URL opened when the preview is activated."
        },
        "title": {
          "type": "string",
          "description": "Title displayed in the preview."
        },
        "description": {
          "type": "string",
          "description": "Short description displayed in the preview."
        },
        "image": {
          "type": "string",
          "description": "Thumbnail image URL."
        },
        "domain": {
          "type": "string",
          "description": "Domain displayed in the preview."
        }
      },
      "required": [
        "id",
        "component",
        "url",
        "title"
      ],
      "additionalProperties": false
    }
  },

  "functions": [
    {
      "name": "openUrl",
      "description": "Opens a webpage URL.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "returnType": {
        "type": "void"
      }
    }
  ]
}
